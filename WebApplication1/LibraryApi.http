    </lib:DeletePublishingCompany>
  </soap:Body>
</soap:Envelope>


### 11. CREATE BOOK
POST {{baseUrl}}/soap/library
Content-Type: text/xml; charset=utf-8
SOAPAction: "http://example.com/library/ILibraryService/CreateBook"

<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/" xmlns:lib="http://example.com/library">
  <soap:Body>
    <lib:CreateBook>
      <lib:request>
        <lib:title>Test Book</lib:title>
        <lib:authorId>{{authorId}}</lib:authorId>
        <lib:publishingCompanyId>{{companyId}}</lib:publishingCompanyId>
        <lib:publishingYear>2025</lib:publishingYear>
      </lib:request>
    </lib:CreateBook>
  </soap:Body>
</soap:Envelope>


### 12. GET BOOK BY ID
POST {{baseUrl}}/soap/library
Content-Type: text/xml; charset=utf-8
SOAPAction: "http://example.com/library/ILibraryService/GetBookById"

<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/" xmlns:lib="http://example.com/library">
  <soap:Body>
    <lib:GetBookById>
      <lib:request>
        <lib:id>{{bookId}}</lib:id>
      </lib:request>
    </lib:GetBookById>
  </soap:Body>
</soap:Envelope>


### 13. UPDATE BOOK
POST {{baseUrl}}/soap/library
Content-Type: text/xml; charset=utf-8
SOAPAction: "http://example.com/library/ILibraryService/UpdateBook"

<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/" xmlns:lib="http://example.com/library">
  <soap:Body>
    <lib:UpdateBook>
      <lib:request>
        <lib:id>{{bookId}}</lib:id>
        <lib:title>Updated Test Book</lib:title>
        <lib:authorId>{{authorId}}</lib:authorId>
        <lib:publishingCompanyId>{{companyId}}</lib:publishingCompanyId>
        <lib:publishingYear>2026</lib:publishingYear>
      </lib:request>
    </lib:UpdateBook>
  </soap:Body>
</soap:Envelope>


### 14. DELETE BOOK
POST {{baseUrl}}/soap/library
Content-Type: text/xml; charset=utf-8
SOAPAction: "http://example.com/library/ILibraryService/DeleteBook"

<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/" xmlns:lib="http://example.com/library">
  <soap:Body>
    <lib:DeleteBook>
      <lib:request>
        <lib:id>{{bookId}}</lib:id>
      </lib:request>
    </lib:DeleteBook>
  </soap:Body>
</soap:Envelope>
