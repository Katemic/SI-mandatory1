
@baseUrl = http://localhost:5002

# Udfyld ID'erne fra Create-operationernes svar
# Brug kun ID'er på testdata, du selv har oprettet
@authorId = 0
@companyId = 0
@bookId = 0


### 1. CREATE AUTHOR
POST {{baseUrl}}/soap/library
Content-Type: text/xml; charset=utf-8
SOAPAction: "http://example.com/library/ILibraryService/CreateAuthor"

<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/" xmlns:lib="http://example.com/library">
  <soap:Body>
    <lib:CreateAuthor>
      <lib:request>
        <lib:name>Test</lib:name>
        <lib:surname>Author</lib:surname>
      </lib:request>
    </lib:CreateAuthor>
  </soap:Body>
</soap:Envelope>


### 2. GET AUTHOR BY ID
POST {{baseUrl}}/soap/library
Content-Type: text/xml; charset=utf-8
SOAPAction: "http://example.com/library/ILibraryService/GetAuthorById"

<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/" xmlns:lib="http://example.com/library">
  <soap:Body>
    <lib:GetAuthorById>
      <lib:request>
        <lib:id>{{authorId}}</lib:id>
      </lib:request>
    </lib:GetAuthorById>
  </soap:Body>
</soap:Envelope>


### 3. LIST ALL AUTHORS
POST {{baseUrl}}/soap/library
Content-Type: text/xml; charset=utf-8
SOAPAction: "http://example.com/library/ILibraryService/ListAuthors"

<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/" xmlns:lib="http://example.com/library">
  <soap:Body>
    <lib:ListAuthors>
      <request />
    </lib:ListAuthors>
  </soap:Body>
</soap:Envelope>


### 4. UPDATE AUTHOR
POST {{baseUrl}}/soap/library
Content-Type: text/xml; charset=utf-8
SOAPAction: "http://example.com/library/ILibraryService/UpdateAuthor"

<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/" xmlns:lib="http://example.com/library">
  <soap:Body>
    <lib:UpdateAuthor>
      <lib:request>
        <lib:id>{{authorId}}</lib:id>
        <lib:name>Updated Test</lib:name>
        <lib:surname>Author</lib:surname>
      </lib:request>
    </lib:UpdateAuthor>
  </soap:Body>
</soap:Envelope>


### 5. DELETE AUTHOR
POST {{baseUrl}}/soap/library
Content-Type: text/xml; charset=utf-8
SOAPAction: "http://example.com/library/ILibraryService/DeleteAuthor"

<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/" xmlns:lib="http://example.com/library">
  <soap:Body>
    <lib:DeleteAuthor>
      <lib:request>
        <lib:id>{{authorId}}</lib:id>
      </lib:request>
    </lib:DeleteAuthor>
  </soap:Body>
</soap:Envelope>


### 6. CREATE PUBLISHING COMPANY
POST {{baseUrl}}/soap/library
Content-Type: text/xml; charset=utf-8
SOAPAction: "http://example.com/library/ILibraryService/CreatePublishingCompany"

<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/" xmlns:lib="http://example.com/library">
  <soap:Body>
    <lib:CreatePublishingCompany>
      <lib:request>
        <lib:name>Test Publishing</lib:name>
      </lib:request>
    </lib:CreatePublishingCompany>
  </soap:Body>
</soap:Envelope>


### 7. GET PUBLISHING COMPANY BY ID
POST {{baseUrl}}/soap/library
Content-Type: text/xml; charset=utf-8
SOAPAction: "http://example.com/library/ILibraryService/GetPublishingCompanyById"

<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/" xmlns:lib="http://example.com/library">
  <soap:Body>
    <lib:GetPublishingCompanyById>
      <lib:request>
        <lib:id>{{companyId}}</lib:id>
      </lib:request>
    </lib:GetPublishingCompanyById>
  </soap:Body>
</soap:Envelope>


### 8. LIST PUBLISHING COMPANIES
POST {{baseUrl}}/soap/library
Content-Type: text/xml; charset=utf-8
SOAPAction: "http://example.com/library/ILibraryService/ListPublishingCompanies"

<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/" xmlns:lib="http://example.com/library">
  <soap:Body>
    <lib:ListPublishingCompanies>
      <request />
    </lib:ListPublishingCompanies>
  </soap:Body>
</soap:Envelope>


### 9. UPDATE PUBLISHING COMPANY
POST {{baseUrl}}/soap/library
Content-Type: text/xml; charset=utf-8
SOAPAction: "http://example.com/library/ILibraryService/UpdatePublishingCompany"

<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/" xmlns:lib="http://example.com/library">
  <soap:Body>
    <lib:UpdatePublishingCompany>
      <lib:request>
        <lib:id>{{companyId}}</lib:id>
        <lib:name>Updated Test Publishing</lib:name>
      </lib:request>
    </lib:UpdatePublishingCompany>
  </soap:Body>
</soap:Envelope>


### 10. DELETE PUBLISHING COMPANY
POST {{baseUrl}}/soap/library
Content-Type: text/xml; charset=utf-8
SOAPAction: "http://example.com/library/ILibraryService/DeletePublishingCompany"

<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/" xmlns:lib="http://example.com/library">
  <soap:Body>
    <lib:DeletePublishingCompany>
      <lib:request>
        <lib:id>{{companyId}}</lib:id>
